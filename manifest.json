{
  "manifest_version": 3,
  "name": "Meet Attire",
  "version": "1.3.0",
  "description": "Hybrid Meet attire: local MediaPipe torso tracking + optional fal.ai CatVTON on outfit change.",
  "action": {
    "default_title": "Meet Attire",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://fal.run/*",
    "https://queue.fal.run/*",
    "https://fal.media/*",
    "https://*.fal.media/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/content.js",
        "content/content.ui.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js",
        "content/content.ui.js",
        "content/b64/*",
        "content/panel.css",
        "assets/attire/*",
        "assets/attire/thumbs/*",
        "assets/icons/*",
        "vendor/mediapipe/*",
        "vendor/mediapipe/wasm/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
