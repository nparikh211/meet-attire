{
  "manifest_version": 3,
  "name": "Meet Attire",
  "version": "1.0.0",
  "description": "Swap professional upper-body attire on your Google Meet camera — 100% local processing.",
  "action": {
    "default_title": "Meet Attire"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js",
        "content/content.ui.js",
        "content/b64/*",
        "content/panel.css",
        "assets/attire/*",
        "assets/attire/thumbs/*",
        "assets/icons/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
